{
  "rules": {
    "rooms": {
      "$code": {
        ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)"
        },
        "seats": {
          ".read": "auth != null",
          "$seat": {
            ".write": "auth != null && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('kind').val() === 'human') || (data.child('uid').val() === auth.uid && !newData.exists()))"
          }
        },
        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "public": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid"
        },
        "private": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid"
        },
        "hands": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid",
          "$seat": {
            ".read": "auth != null && (root.child('rooms').child($code).child('seats').child($seat).child('uid').val() === auth.uid || root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid)"
          }
        },
        "actions": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid",
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid"
          }
        },
        "chat": {
          ".read": "auth != null",
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 200 && newData.child('sk').isString() && (root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid || root.child('rooms').child($code).child('seats').child(newData.child('sk').val()).child('uid').val() === auth.uid)"
          }
        },
        "errors": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
